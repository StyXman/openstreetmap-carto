Index: osm-carto/style.mss
===================================================================
--- osm-carto.orig/style.mss
+++ osm-carto/style.mss
@@ -25,3 +25,19 @@ Map {
   [zoom >= 7] { raster-opacity: 0.8; }
   [zoom >= 8] { raster-opacity: 0.7; }
 }
+
+// shade-small [0-6], shade-big [7]
+.shade-over {
+  comp-op: src-over;
+  raster-scaling: lanczos;
+  raster-opacity: 0.15;
+}
+
+// shade-medium [8], shade-big [9-]
+.shade-overlay {
+  raster-scaling: lanczos;
+  [zoom >=8] {
+    comp-op: overlay;
+    raster-opacity: 0.5;
+  }
+}
