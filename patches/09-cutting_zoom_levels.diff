Index: osm-carto/style.mss
===================================================================
--- osm-carto.orig/style.mss
+++ osm-carto/style.mss
@@ -15,6 +15,14 @@ Map {
                 "Mukti Narrow Regular", "gargi Medium", "TSCu_Paranar Regular", "Tibetan Machine Uni Regular", "Mallige Normal",
                 "Droid Sans Fallback Regular", "Unifont Medium", "unifont Medium";
 
+// nice stuff is things that are not so common and that I like to see from far,
+// like castles, viewpoints and such
+@nice: 11;
+// it's also the max general zoom level
+@emergency: 14;
+// things that are useful and common enough to see in the near range
+@useful: 16;
+
